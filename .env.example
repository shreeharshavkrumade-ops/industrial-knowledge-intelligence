################################################################################
# Industrial Knowledge Intelligence — environment variable template
#
# Copy this file to .env in the same directory as app.py and fill in your keys.
# The .env file is listed in .gitignore and will NOT be committed to version control.
################################################################################

# Google Gemini API key — enables the AI Knowledge Assistant.
#
# How to get a FREE key (no billing required):
#   1. Visit https://aistudio.google.com/app/apikey
#   2. Sign in with your Google account
#   3. Click "Create API Key"
#   4. Paste the key below
#
# Free-tier limits:
#   • 15 requests / minute
#   • 1 500 requests / day
#   • No credit card or billing setup needed
#
# Model used: gemini-2.0-flash
GEMINI_API_KEY=AIza-your-key-here

# ── Notes ──────────────────────────────────────────────────────────────────
# * Without this key the assistant runs in local extractive mode (no API calls).
# * Only short retrieved excerpts (~8 000 chars max) are sent to the API,
#   not your full documents.
# * Never commit a real API key to version control.
# * If you hit the free-tier daily quota the app falls back to local search
#   automatically and resets the next day.
